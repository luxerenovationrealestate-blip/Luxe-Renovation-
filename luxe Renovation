<script>
function toggleMobileMenu() {
const menu = document.getElementById('mobile-menu');
menu.classList.toggle('hidden');
}
function updateArea(val) {
document.getElementById('area-val').innerText = val + ' m²';
calculatePrice();
}
function calculatePrice() {
const area = parseInt(document.getElementById('area-slider').value);
const typeInput = document.querySelector('input[name="project_type"]:checked');
let rate = 1500;
if(typeInput) {
if(typeInput.value === 'comfort') rate = 2200;
if(typeInput.value === 'premium') rate = 3200;
}
let total = area * rate;
if(document.getElementById('addon-bath').checked) total += 35000;
if(document.getElementById('addon-kitchen').checked) total += 25000;
document.getElementById('total-price').innerText = total.toLocaleString('da-DK') + ' kr.';
}
function scrollToContact() {
document.getElementById('contact').scrollIntoView({ behavior: 'smooth' });
}
